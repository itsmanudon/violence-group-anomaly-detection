runs/indian_pilot/experiments_v3/*/registration.json
!runs/indian_pilot/experiments_v3/v3_all_s7/registration.json

# Model bundle checksum list, unpacked at the repo root (docs/RUN_THE_MODEL.md).
/MANIFEST.sha256
